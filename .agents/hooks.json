{
  "ultragentic": {
    "PreInvocation": [
      {
        "hooks": [
          { "type": "command", "command": "ultragentic hook user-prompt-submit --client antigravity" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "ultragentic hook pre-tool-use --client antigravity" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "ultragentic hook post-tool-use --client antigravity" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "ultragentic hook stop --client antigravity" }
        ]
      }
    ]
  }
}
