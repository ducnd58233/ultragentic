**/*/.env
**/*/settings.local.json

# Generated by scripts/link-ai-agents.* — edit assets under .ai-agents/ only; run link after clone.
/.claude/skills/
/.claude/agents/
/.claude/commands/
/.cursor/skills/
/.cursor/commands/
/.opencode/agents/
/.opencode/commands/
/.agents/skills/
/.agents/commands/
/.codex/agents/
/.codex/prompts/
/.codex/commands/
/.codex/skills/
# Goal verification artifacts from /goal (local only; see .ai-agents/references/goal-verification-records.md)
# Canonical run state: .agent-state/runs/<date>/<slug>/<version>/. /tmp/ stays ignored
# so a leftover tree is not offered for commit.
/tmp/

# Workspace-local runtime state: cross-run memory database, caches, runtime logs,
# evidence under runs/, and fetch assets. The whole tree is local-only.
/.agent-state/

# Python bytecode from the hook scripts.
__pycache__/
*.pyc

# Downloaded runtime binaries (scripts/install-runtime.* installs to ~/.local/bin).
*.exe
*.exe~
/docs/

# Top-level /skills/ is sometimes generated by link scripts; canonical source is .ai-agents/skills/.
/skills/
